NODE_ENV=development
DATABASE_URL=postgresql://tamreedy:dev_change_me@localhost:5432/tamreedy
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_MAX_LIFETIME_SECONDS=1800
REDIS_URL=redis://localhost:6379
LIVE_LOCATION_REDIS_ENABLED=false
LOCATION_POSTGRES_FALLBACK_ENABLED=true
LIVE_LOCATION_TTL_SECONDS=150
LOCATION_POSTGRES_CHECKPOINT_SECONDS=30
LOCATION_MAX_AGE_SECONDS=120
LOCATION_MAX_FUTURE_SECONDS=30
LOCATION_MAX_ACCURACY_METERS=150
LOCATION_MAX_SPEED_MPS=70
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=900
CALL_RING_TIMEOUT_SECONDS=40
CALL_SIGNAL_MAX_BYTES=32768
CALL_MAX_ICE_CANDIDATES=128
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS_FOR_LOCAL_DEVELOPMENT
JWT_ISSUER=tamreedy-api
JWT_AUDIENCE=tamreedy-mobile
API_PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
# Production requires an independent 32-byte hex key; never reuse JWT_SECRET.
DOCS_ENC_KEY=
ALLOW_LEGACY_UNBOUND_SESSIONS=false
# NO real wallet provider enabled in phase 1. Do not use customer funds.
WALLET_PROVIDER_ENABLED=false
# Interim login: 'password' (accounts created by an admin) or 'otp' (needs an SMS gateway; last phase)
AUTH_MODE=password
# Push (optional). Full service-account JSON on one line; unset = push disabled.
FCM_SERVICE_ACCOUNT_JSON=
# Preferred: path to the key file kept OUTSIDE the repo, e.g. C:/Users/<you>/.tamreedy/fcm-service-account.json
FCM_SERVICE_ACCOUNT_FILE=
# Routes/ETA provider: 'osm' (OpenRouteService, free key, no card) or 'google' (needs billing)
MAPS_PROVIDER=osm
ORS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
ROUTES_CACHE_TTL_SECONDS=30
ROUTES_CACHE_MAX_ENTRIES=500
ROUTES_CIRCUIT_FAILURE_THRESHOLD=5
ROUTES_CIRCUIT_OPEN_SECONDS=30
