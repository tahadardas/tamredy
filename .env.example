NODE_ENV=development
DATABASE_URL=postgresql://tamreedy:dev_change_me@localhost:5432/tamreedy
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS_FOR_LOCAL_DEVELOPMENT
JWT_ISSUER=tamreedy-api
JWT_AUDIENCE=tamreedy-mobile
API_PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
# NO real wallet provider enabled in phase 1. Do not use customer funds.
WALLET_PROVIDER_ENABLED=false
# Interim login: 'password' (accounts created by an admin) or 'otp' (needs an SMS gateway; last phase)
AUTH_MODE=password
# Push (optional). Full service-account JSON on one line; unset = push disabled.
FCM_SERVICE_ACCOUNT_JSON=
# Preferred: path to the key file kept OUTSIDE the repo, e.g. C:/Users/<you>/.tamreedy/fcm-service-account.json
FCM_SERVICE_ACCOUNT_FILE=
# Routes/ETA provider: 'osm' (OpenRouteService, free key, no card) or 'google' (needs billing)
MAPS_PROVIDER=osm
ORS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
