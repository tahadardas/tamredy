# Copy to infra/docker/.env and edit. NEVER commit the real file.
# Generate secrets with:  openssl rand -hex 24      (hex only: safe inside connection URLs)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# interim login: password (accounts created from the dashboard). Use otp only after an SMS gateway exists.
AUTH_MODE=password
# Route/ETA provider for the maps: osm (OpenRouteService, free key) or google
MAPS_PROVIDER=osm
ORS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
# Host ports (bound to 127.0.0.1 only; Plesk proxies to them)
API_PORT=18300
ADMIN_PORT=18380
ALLOWED_ORIGINS=
# Listening address of the published ports. 127.0.0.1 = only Plesk/nginx can reach them (use with a domain + HTTPS).
# 0.0.0.0 = reachable from the internet by IP (pilot WITHOUT a domain; traffic is NOT encrypted).
API_BIND=127.0.0.1
ADMIN_BIND=127.0.0.1

# Encryption key for staff documents (64 hex chars). Generate: openssl rand -hex 32
# Keep a copy safely: without it the uploaded documents cannot be decrypted.
DOCS_ENC_KEY=

# Enable only after staging validation and operational approval.
OPEN_DISPATCH_ENABLED=false
SCHEDULED_VISITS_ENABLED=false
GUARDIAN_CHECKINS_ENABLED=false
GUARDIAN_RETENTION_ENABLED=false
GUARDIAN_ROUTING_ENABLED=false
GUARDIAN_NIGHT_POLICY_ENABLED=false
GUARDIAN_ACK_SECONDS=30

# Dedicated 32-byte hexadecimal key for Guardian evidence export encryption.
GUARDIAN_EVIDENCE_KEY=

# Coturn must be exposed directly; do not proxy these ports through HTTP nginx.
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=
TURN_SHARED_SECRET=
TURN_TLS_DIR=/etc/letsencrypt/live/turn.example.com
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=900
CALL_RING_TIMEOUT_SECONDS=40
LIVE_LOCATION_REDIS_ENABLED=false
